{
  "name": "ceeqbot",
  "version": "1.0.0",
  "description": "AI-Powered CRM & Sales Management Platform",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:api": "jest --testPathPattern=tests/integration",
    "test:unit": "jest --testPathPattern=tests/unit",
    "test:e2e": "jest --testPathPattern=tests/e2e",
    "test:performance": "artillery run tests/performance/load-test.yml",
    "test:security": "jest --testPathPattern=tests/security",
    "test:all": "npm run test:unit && npm run test:api && npm run test:e2e",
    "mockserver:start": "node tests/helpers/mockserver.js",
    "mockserver:stop": "curl -X PUT http://localhost:1080/stop",
    "test:with-mocks": "concurrently \"npm run mockserver:start\" \"wait-port 1080 && npm run test:api && npm run mockserver:stop\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "lucide-react": "^0.525.0",
    "node-fetch": "^3.3.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.3",
    "vite": "^7.0.2",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.8",
    "artillery": "^2.0.13",
    "autoprefixer": "^10.4.21",
    "axios": "^1.6.2",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "faker": "^5.5.3",
    "jest": "^29.7.0",
    "jsonschema": "^1.4.1",
    "mockserver-client": "^5.15.0",
    "mockserver-node": "^5.15.0",
    "postcss": "^8.5.6",
    "socket.io-client": "^4.7.4",
    "supertest": "^6.3.3",
    "tailwindcss": "^3.4.17",
    "wait-port": "^1.1.0",
    "ws": "^8.14.2"
  }
}
