# Local Environment Configuration for SalesTracker CRM
# Copy this file to .env.local and customize for your environment

# Authentication Mode Configuration
# Set to 'api' for backend integration or 'mock' for standalone demo
VITE_AUTH_MODE=mock

# API Configuration (when AUTH_MODE=api)
VITE_API_BASE_URL=http://localhost:5555
VITE_ENABLE_API_INTEGRATION=false

# When backend is available, set these:
# VITE_AUTH_MODE=api
# VITE_ENABLE_API_INTEGRATION=true

# Development Features
VITE_ENABLE_API_LOGGING=true
VITE_ENABLE_ERROR_REPORTING=false

# Authentication Settings
VITE_TOKEN_STORAGE_TYPE=localStorage
VITE_ENABLE_TOKEN_REFRESH=true
VITE_TOKEN_REFRESH_THRESHOLD=300