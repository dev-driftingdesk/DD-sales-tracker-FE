# Environment Configuration for SalesTracker CRM

# API Configuration
VITE_API_BASE_URL=http://localhost:5555/api/v1
VITE_API_TIMEOUT=10000
VITE_API_MAX_RETRIES=3
VITE_API_RETRY_DELAY=1000
VITE_API_RETRY_MULTIPLIER=2
VITE_API_MAX_CONCURRENT=10
VITE_API_QUEUE_SIZE=100

# Feature Flags - API Integration
VITE_ENABLE_API_INTEGRATION=true
# CRITICAL: Set to true only when backend API is ready
# When false, app uses mock data (current behavior)
# When true, app attempts real API calls
VITE_ENABLE_API_LOGGING=true

# Authentication Configuration
VITE_TOKEN_STORAGE_TYPE=localStorage
# Options: localStorage, sessionStorage
VITE_ENABLE_TOKEN_REFRESH=true
VITE_TOKEN_REFRESH_THRESHOLD=300
# Refresh token if expires in less than 5 minutes (300 seconds)

# Security Configuration
VITE_CSRF_ENABLED=false
VITE_CSRF_HEADER_NAME=X-CSRF-Token
VITE_RATE_LIMIT_ENABLED=true
VITE_MAX_LOGIN_ATTEMPTS=5
VITE_LOGIN_COOLDOWN_MINUTES=15

# Development Configuration
VITE_MOCK_DELAY=1000
VITE_ENABLE_HOT_RELOAD=true

# Feature Flags - User Features
VITE_ENABLE_EMAIL_VERIFICATION=true
VITE_ENABLE_REMEMBER_ME=true
VITE_ENABLE_PASSWORD_STRENGTH=true

# Error Handling
VITE_ENABLE_ERROR_REPORTING=false
VITE_ERROR_REPORTING_URL=
VITE_ENABLE_ERROR_BOUNDARY=true

# Performance Features
VITE_ENABLE_SERVICE_WORKER=false
VITE_ENABLE_LAZY_LOADING=true
VITE_ENABLE_COMPRESSION=false

# ========================================
# DEPLOYMENT ENVIRONMENT EXAMPLES
# ========================================

# Production Environment (.env.production)
# VITE_ENABLE_API_INTEGRATION=true
# VITE_API_BASE_URL=/api/v1
# VITE_ENABLE_API_LOGGING=false
# VITE_ENABLE_ERROR_REPORTING=true
# VITE_ERROR_REPORTING_URL=https://errors.salestracker.com
# VITE_ENABLE_SERVICE_WORKER=true
# VITE_ENABLE_COMPRESSION=true

# Staging Environment (.env.staging)
# VITE_ENABLE_API_INTEGRATION=true
# VITE_API_BASE_URL=https://staging-api.salestracker.com/api/v1
# VITE_ENABLE_API_LOGGING=true
# VITE_ENABLE_ERROR_REPORTING=true

# Testing Environment (.env.test)
# VITE_ENABLE_API_INTEGRATION=false
# VITE_TOKEN_STORAGE_TYPE=sessionStorage
# VITE_MOCK_DELAY=100
# VITE_ENABLE_TOKEN_REFRESH=false
